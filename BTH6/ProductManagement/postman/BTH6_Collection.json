								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/reports/sync",
							"host": ["{{gateway_url}}"],
							"path": ["reports", "sync"]
						},
						"description": "Đồng bộ dữ liệu từ Product Service và Order Service"
					}
				},
				{
					"name": "5.2 Create Order Report",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.orderReport && jsonData.orderReport._id) {",
									"    pm.environment.set(\"order_report_id\", jsonData.orderReport._id);",
									"    console.log(\"Order Report ID saved: \" + jsonData.orderReport._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"orderId\": \"{{order_id}}\",\n    \"customer_name\": \"Nguyen Van A\",\n    \"customer_email\": \"nguyenvana@email.com\",\n    \"products\": [\n        {\n            \"product_id\": \"{{product_id}}\",\n            \"product_name\": \"Laptop Dell XPS 15\",\n            \"total_sold\": 2,\n            \"revenue\": 50000000,\n            \"cost\": 30000000\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/reports/orders",
							"host": ["{{gateway_url}}"],
							"path": ["reports", "orders"]
						},
						"description": "API: POST localhost:4003/reports/orders - Tạo báo cáo đơn hàng"
					}
				},
