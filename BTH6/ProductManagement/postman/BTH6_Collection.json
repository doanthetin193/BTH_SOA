{
	"info": {
		"_postman_id": "bth6-product-management-workflow",
		"name": "BTH6 - Product Management Workflow",
		"description": "Postman Collection để kiểm thử quy trình mua hàng theo Bài thực hành số 6\n\n## Quy trình mua hàng:\n1. Đăng ký/Đăng nhập\n2. Xem sản phẩm\n3. Tạo đơn hàng\n4. Thêm sản phẩm vào đơn hàng\n5. Cập nhật trạng thái đơn hàng\n6. Tạo báo cáo",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1.1 Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/auth/register",
							"host": ["{{gateway_url}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "1.2 Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"auth_token\", jsonData.token);",
									"    console.log(\"Token saved: \" + jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/auth/login",
							"host": ["{{gateway_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "1.3 Verify Token",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/auth/verify",
							"host": ["{{gateway_url}}"],
							"path": ["auth", "verify"]
						}
					}
				}
			]
		},
		{
			"name": "2. Product Management",
			"item": [
				{
					"name": "2.1 Create Product",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData._id) {",
									"    pm.environment.set(\"product_id\", jsonData._id);",
									"    console.log(\"Product ID saved: \" + jsonData._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Laptop Dell XPS 15\",\n    \"description\": \"Laptop cao cấp với màn hình 15.6 inch\",\n    \"price\": 25000000,\n    \"quantity\": 50\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/products",
							"host": ["{{gateway_url}}"],
							"path": ["products"]
						}
					}
				},
				{
					"name": "2.2 Get All Products",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/products",
							"host": ["{{gateway_url}}"],
							"path": ["products"]
						},
						"description": "API: GET localhost:4001/products - Khách hàng chọn sản phẩm"
					}
				},
				{
					"name": "2.3 Get Product by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/products/{{product_id}}",
							"host": ["{{gateway_url}}"],
							"path": ["products", "{{product_id}}"]
						}
					}
				},
				{
					"name": "2.4 Update Product",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Laptop Dell XPS 15 Updated\",\n    \"description\": \"Laptop cao cấp với màn hình 15.6 inch - Phiên bản mới\",\n    \"price\": 26000000,\n    \"quantity\": 45\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/products/{{product_id}}",
							"host": ["{{gateway_url}}"],
							"path": ["products", "{{product_id}}"]
						},
						"description": "API: PUT localhost:4001/products/id - Cập nhật lại số lượng sản phẩm"
					}
				}
			]
		},
		{
			"name": "3. Order Management",
			"item": [
				{
					"name": "3.1 Create Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.order && jsonData.order._id) {",
									"    pm.environment.set(\"order_id\", jsonData.order._id);",
									"    console.log(\"Order ID saved: \" + jsonData.order._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customerName\": \"Nguyen Van A\",\n    \"customerEmail\": \"nguyenvana@email.com\",\n    \"products\": [\n        {\n            \"productId\": \"{{product_id}}\",\n            \"quantity\": 2,\n            \"unit_price\": 25000000\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/orders",
							"host": ["{{gateway_url}}"],
							"path": ["orders"]
						},
						"description": "API: POST localhost:4002/orders - Tạo đơn hàng qua dịch vụ quản lý đơn hàng"
					}
				},
				{
					"name": "3.2 Get All Orders",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/orders",
							"host": ["{{gateway_url}}"],
							"path": ["orders"]
						}
					}
				},
				{
					"name": "3.3 Get Order by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/orders/{{order_id}}",
							"host": ["{{gateway_url}}"],
							"path": ["orders", "{{order_id}}"]
						}
					}
				},
				{
					"name": "3.4 Update Order Status (Completed)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"completed\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/orders/{{order_id}}",
							"host": ["{{gateway_url}}"],
							"path": ["orders", "{{order_id}}"]
						},
						"description": "API: PUT localhost:4002/orders/:id - Cập nhật trạng thái đơn hàng khi thanh toán và vận chuyển"
					}
				}
			]
		},
		{
			"name": "4. Order Items",
			"item": [
				{
					"name": "4.1 Create Order Item",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.orderItem && jsonData.orderItem._id) {",
									"    pm.environment.set(\"order_item_id\", jsonData.orderItem._id);",
									"    console.log(\"Order Item ID saved: \" + jsonData.orderItem._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"orderId\": \"{{order_id}}\",\n    \"productId\": \"{{product_id}}\",\n    \"quantity\": 1,\n    \"unitPrice\": 25000000\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/order_items",
							"host": ["{{gateway_url}}"],
							"path": ["order_items"]
						},
						"description": "API: POST localhost:4002/order_items - Thêm các sản phẩm của đơn hàng"
					}
				},
				{
					"name": "4.2 Get All Order Items",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/order_items?orderId={{order_id}}",
							"host": ["{{gateway_url}}"],
							"path": ["order_items"],
							"query": [
								{
									"key": "orderId",
									"value": "{{order_id}}"
								}
							]
						}
					}
				},
				{
					"name": "4.3 Get Order Item by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/order_items/{{order_item_id}}",
							"host": ["{{gateway_url}}"],
							"path": ["order_items", "{{order_item_id}}"]
						}
					}
				},
				{
					"name": "4.4 Update Order Item",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"quantity\": 3,\n    \"unitPrice\": 24000000\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/order_items/{{order_item_id}}",
							"host": ["{{gateway_url}}"],
							"path": ["order_items", "{{order_item_id}}"]
						}
					}
				},
				{
					"name": "4.5 Delete Order Item",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/order_items/{{order_item_id}}",
							"host": ["{{gateway_url}}"],
							"path": ["order_items", "{{order_item_id}}"]
						}
					}
				}
			]
		},
		{
			"name": "5. Reports",
			"item": [
				{
					"name": "5.1 Sync Report Data",
